HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://awesomejm:awesomejm_dev@127.0.0.1:5433/awesomejm

# One shop per deployment; use the same ID for staff setup and API runtime.
APP_SHOP_ID=00000000-0000-4000-8000-000000000001
# Production: NODE_ENV=production and exact HTTPS frontend origin are required.
# APP_ORIGIN=https://jewellery.example.com
# Recovery operator environment only (never give the API the recovery key):
# BACKUP_KEY_FILE=/secure/awesomejm/primary.recovery-key
# BACKUP_DIR=/var/backups/awesomejm
# RECOVERY_ADMIN_URL=postgres://recovery_operator:SECRET@private-host:5432/postgres
# PG_TOOLS=docker # local Compose tools only; production defaults to host pg_dump/pg_restore
