{
  "name": "@awesomejm/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts vite.config.ts",
    "test": "node --test test/*.test.mjs && pnpm test:ui",
    "i18n:types": "node scripts/i18n-schema.mjs",
    "test:ui": "vitest run test/navigation.test.tsx --environment jsdom"
  },
  "dependencies": {
    "@awesomejm/calculations": "workspace:*",
    "@awesomejm/contracts": "workspace:*",
    "nepali-date-converter": "3.3.4",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@awesomejm/tooling": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
