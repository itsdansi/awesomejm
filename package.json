{
  "name": "awesomejm",
  "version": "1.0.0",
  "private": true,
  "description": "AwesomeJM is a SaaS application for Nepali jewellery businesses.",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "pnpm --filter @awesomejm/api db:migrate",
    "test:integration": "pnpm build && pnpm --filter @awesomejm/api test:integration",
    "staff:owner": "pnpm --filter @awesomejm/api staff:owner",
    "staff:reset": "pnpm --filter @awesomejm/api staff:reset",
    "db:backup": "pnpm --filter @awesomejm/api db:backup",
    "db:backup-key": "pnpm --filter @awesomejm/api db:backup-key",
    "db:verify-backup": "pnpm --filter @awesomejm/api db:verify-backup",
    "db:restore": "pnpm --filter @awesomejm/api db:restore",
    "i18n:types": "pnpm --filter @awesomejm/web i18n:types"
  },
  "keywords": [],
  "author": "Dansi Acharya",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.9",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@awesomejm/tooling": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
